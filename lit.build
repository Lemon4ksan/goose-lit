// goose-lit package build configuration sidecar.
// Configures C11 process execution and probe counter runtime shim.
c_sources_windows = ["shim/proc.c"];
c_sources_linux = ["shim/proc.c"];
c_sources_macos = ["shim/proc.c"];
c_flags_cc = ["-mstackrealign"];
c_flags_cc_windows = ["-mstackrealign", "-Wl,--stack,33554432"];
c_flags_msvc = ["/std:c11", "/STACK:33554432"];
exclude = ["scratch", "bin"];
